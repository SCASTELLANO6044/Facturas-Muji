{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Facturas Muji",
  "version": "0.1.0",
  "identifier": "com.facturasmuji.renamer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Facturas Muji",
        "width": 1240,
        "height": 960,
        "minWidth": 760,
        "minHeight": 640,
        "backgroundColor": "#f7f8f5"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
